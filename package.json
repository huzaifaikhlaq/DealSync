    "@tanstack/react-table": "^9.3.1",
    "argon2": "^0.45.2",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
